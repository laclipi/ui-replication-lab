# Example environment file — copy to `.env.local` and fill in.
# .env.local is gitignored; only this template lives in source control.

# Site URL
# --------
# Canonical absolute origin of the site. Used to build:
#   - metadataBase (root layout) → absolute URLs in OG/Twitter tags.
#   - sitemap.xml loc entries.
#   - robots.txt sitemap line.
#
# In local dev you can leave it blank — the code falls back to http://localhost:3000.
# In production set it to the public origin (no trailing slash):
#   NEXT_PUBLIC_SITE_URL=https://uilab.example.com
NEXT_PUBLIC_SITE_URL=
