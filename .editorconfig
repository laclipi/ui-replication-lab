# EditorConfig — cross-editor consistency
# https://editorconfig.org
#
# Tells every modern editor how to format files in this repo so we don't
# rely on each contributor's IDE config matching Prettier's expectations.

root = true

[*]
charset = utf-8
end_of_line = lf            # LF on every platform — keeps Windows from injecting CRLF
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown lets trailing spaces signal hard line breaks — keep them
[*.md]
trim_trailing_whitespace = false

# Makefiles require literal tabs
[Makefile]
indent_style = tab
